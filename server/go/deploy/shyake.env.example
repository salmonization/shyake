# Settings for shyake-server, read from the environment.
# The systemd unit loads this file from /etc/shyake/shyake.env.

# Required. The domain other instances reach you at. It is part of
# every address on this instance: user@mail.example.org
SHYAKE_INSTANCE_DOMAIN=mail.example.org

# Keep the server on loopback behind a TLS reverse proxy.
SHYAKE_LISTEN=127.0.0.1:8787

# Defaults are shown commented out.
#SHYAKE_REGISTRATION_ENABLED=true
#SHYAKE_RESERVED_USERNAMES=admin,system,support,noreply,shyake,root,postmaster
#SHYAKE_FEDERATION_ENABLED=true
#SHYAKE_MAX_MAIL_SIZE=196608

# Addresses whose X-Forwarded-For header is trusted. Set this to your
# reverse proxy. If the proxy is not listed, every client counts as the
# proxy's address and they all share one rate limit.
#SHYAKE_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Requests per second per client address, and the burst allowance.
#SHYAKE_RATE_LIMIT=5
#SHYAKE_RATE_BURST=30

# text or json
#SHYAKE_LOG_FORMAT=text

# GitHub token for the release lookup behind `shyake update`. Optional.
# Without it, GitHub allows 60 lookups an hour per IP address. A
# fine-grained token with no permissions is enough.
#SHYAKE_GITHUB_TOKEN=
